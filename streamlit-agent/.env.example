# Copy this file to .env and fill in your real key.
# .env is where the LLM credential lives — NOT the MCP server, and NOT config.yaml.
# Get a key at https://platform.openai.com/account/api-keys

OPENAI_API_KEY=sk-your-key-here

# Optional overrides — leave commented to use config.yaml's values
# MCP_SERVER_URL=http://localhost:8000/mcp
# OPENAI_MODEL=gpt-4o
